index 0000000..5e453e3
--- /dev/null
+++ b/source/Lib/CommonLib/WeightMap.h
@@ -0,0 +1,149 @@
+/** \file     WeightMap.h
+    \brief    per-pixel importance weights for weighted-MSE RDO (header)
+
+    The weights are the diagonal of the Hessian of a perceptual metric, evaluated
+    at the source picture.  Feeding them to the encoder turns the RD objective
+    J = SSE + lambda * R into J = sum_i w_i (x_i - xhat_i)^2 + lambda * R, which is
+    a second-order approximation of  metric(x, xhat) + lambda * R.
+
+    File format (little endian, matches the .dat produced by the python side):
+      uint32                          numFrames
+      repeated numFrames times:
+        float32 [ lumaW * lumaH ]     Y plane, raster scan
+        float32 [ chromaW * chromaH ] Cb plane, raster scan
+        float32 [ chromaW * chromaH ] Cr plane, raster scan
+*/
+
+#ifndef __WEIGHTMAP__
+#define __WEIGHTMAP__
+
+#include "CommonDef.h"
+#include "ChromaFormat.h"
+
+#include <string>
+#include <vector>
+#include <fstream>
+
+//! \ingroup CommonLib
+//! \{
+
+class WeightMap
+{
+private:
+  struct Plane
+  {
+    std::vector<float> w;
+    int                width  = 0;
+    int                height = 0;
+    ptrdiff_t          stride = 0;
+  };
+
+  Plane m_planes[MAX_NUM_COMPONENT];
+
+  bool   m_enabled = false;
+  double m_tau        = 0.0;   // shrink-to-uniform regularisation: w <- (w + tau) / (1 + tau)
+  bool   m_globalNorm = false; // normalise all planes together instead of one mean per plane
+
+  // optional non-diagonal form: one blk x blk Hessian per blk x blk tile, row-major inside a
+  // tile.  H = 2 J^T J for LPIPS, so these come from the same probes as the diagonal.
+  bool               m_hasBlocks = false;
+  int                m_blkSize   = 0;
+  std::vector<float> m_blk[MAX_NUM_COMPONENT];
+  int                m_nbx[MAX_NUM_COMPONENT] = { 0, 0, 0 };
+  int                m_nby[MAX_NUM_COMPONENT] = { 0, 0, 0 };
+  // set at load when every tile of the plane has all off-diagonals exactly zero (identity
+  // chroma of a luma-only metric): the kernel then takes an O(n) path, bit-identical
+  bool               m_blkDiagOnly[MAX_NUM_COMPONENT] = { false, false, false };
+  // Rank-K factored tiles: H_t = F_t F_t^T + facAdd * I after the tau shrink, F_t stored
+  // k-major (K rows of n) so the kernel does K contiguous dot products instead of an n x n
+  // matvec.  Storage n*K per tile instead of n*n.
+  bool               m_hasFactors = false;
+  int                m_K          = 0;
+  float              m_facAdd     = 0.0f;
+  std::vector<float> m_fac[MAX_NUM_COMPONENT];
+  bool               m_hasFacDiag = false;      // v3: residual diagonal alongside the factors
+  std::vector<float> m_facDiag[MAX_NUM_COMPONENT];
+  int    m_frame   = -1;
+
+public:
+  WeightMap()  = default;
+  ~WeightMap() = default;
+
+  //! allocate the planes (all weights = 1.0) and, if fileName is not empty, load them
+  bool init(int lumaWidth, int lumaHeight, ChromaFormat chromaFormat, const std::string &fileName, int frameIndex,
+            double tau, bool globalNorm = false);
+
+  void clear();
+
+  bool isEnabled() const { return m_enabled; }
+
+  int       getWidth (const ComponentID compId) const { return m_planes[compId].width;  }
+  int       getHeight(const ComponentID compId) const { return m_planes[compId].height; }
+  ptrdiff_t getStride(const ComponentID compId) const { return m_planes[compId].stride; }
+
+  //! pointer to the weight of sample (x, y) of component compId, or nullptr if out of range
+  const float *getPtr(const ComponentID compId, const int x, const int y) const
+  {
+    const Plane &p = m_planes[compId];
+    if (!m_enabled || p.w.empty() || x < 0 || y < 0 || x >= p.width || y >= p.height)
+    {
+      return nullptr;
+    }
+    return &p.w[(size_t) y * (size_t) p.stride + (size_t) x];
+  }
+
+  //! mean weight of a rectangle, used to scale the RDOQ / transform-domain lambda
+  double getMeanWeight(const ComponentID compId, const int x, const int y, const int width, const int height) const;
+
+  double getTau() const { return m_tau; }
+
+  bool hasBlocks()   const { return m_hasBlocks; }
+  int  getBlkSize()  const { return m_blkSize; }
+  int  getNumBlkX(const ComponentID c) const { return m_nbx[c]; }
+  int  getNumBlkY(const ComponentID c) const { return m_nby[c]; }
+  bool blockPlaneIsDiagonal(const ComponentID c) const { return m_hasBlocks && m_blkDiagOnly[c]; }
+
+  //! the blk*blk x blk*blk Hessian of the tile containing sample (x, y), or nullptr
+  const float *getBlockMatrix(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasBlocks || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_blk[compId][((size_t) by * m_nbx[compId] + bx) * n * n];
+  }
+
+  bool loadBlockFile(const std::string &fileName);
+  bool loadFactorFile(std::ifstream &f, uint32_t blk, bool withDiag);
+  bool hasFacDiag() const { return m_hasFacDiag; }
+  const float *getBlockFacDiag(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasFacDiag || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_facDiag[compId][((size_t) by * m_nbx[compId] + bx) * n];
+  }
+  bool  hasFactors() const { return m_hasFactors; }
+  int   getK()       const { return m_K; }
+  float getFacAdd()  const { return m_facAdd; }
+  const float *getBlockFactor(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasFactors || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_fac[compId][((size_t) by * m_nbx[compId] + bx) * n * (size_t) m_K];
+  }
+
+private:
+  bool loadFromFile(const std::string &fileName, int frameIndex);
+  void applyTau();
+};
+
+//! \}
+
+#endif   // __WEIGHTMAP__

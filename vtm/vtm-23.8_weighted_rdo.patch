+/** \file     WeightMap.cpp
+    \brief    per-pixel importance weights for weighted-MSE RDO
+*/
+
+#include "WeightMap.h"
+
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <numeric>
+
+void WeightMap::clear()
+{
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    std::vector<float>().swap(m_planes[c].w);
+    m_planes[c].width = m_planes[c].height = 0;
+    m_planes[c].stride                     = 0;
+  }
+  m_enabled = false;
+  m_frame   = -1;
+}
+
+bool WeightMap::init(int lumaWidth, int lumaHeight, ChromaFormat chromaFormat, const std::string &fileName,
+                     int frameIndex, double tau, bool globalNorm)
+{
+  clear();
+
+  m_tau        = tau;
+  m_frame      = frameIndex;
+  m_globalNorm = globalNorm;
+
+  m_planes[COMPONENT_Y].width  = lumaWidth;
+  m_planes[COMPONENT_Y].height = lumaHeight;
+  m_planes[COMPONENT_Y].stride = lumaWidth;
+  m_planes[COMPONENT_Y].w.assign((size_t) lumaWidth * (size_t) lumaHeight, 1.0f);
+
+  const int csx = getChannelTypeScaleX(ChannelType::CHROMA, chromaFormat);
+  const int csy = getChannelTypeScaleY(ChannelType::CHROMA, chromaFormat);
+
+  for (int c = COMPONENT_Cb; c <= COMPONENT_Cr; c++)
+  {
+    if (chromaFormat == ChromaFormat::_400)
+    {
+      m_planes[c].width = m_planes[c].height = 0;
+      m_planes[c].stride                     = 0;
+      continue;
+    }
+    m_planes[c].width  = (lumaWidth + (1 << csx) - 1) >> csx;
+    m_planes[c].height = (lumaHeight + (1 << csy) - 1) >> csy;
+    m_planes[c].stride = m_planes[c].width;
+    m_planes[c].w.assign((size_t) m_planes[c].width * (size_t) m_planes[c].height, 1.0f);
+  }
+
+  m_enabled = true;
+
+  if (!fileName.empty() && !loadFromFile(fileName, frameIndex))
+  {
+    clear();
+    return false;
+  }
+
+  applyTau();
+
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_planes[c].w.empty())
+    {
+      continue;
+    }
+    const double mean =
+      std::accumulate(m_planes[c].w.begin(), m_planes[c].w.end(), 0.0) / (double) m_planes[c].w.size();
+    double lo = m_planes[c].w[0];
+    double hi = m_planes[c].w[0];
+    for (const float v: m_planes[c].w)
+    {
+      lo = std::min(lo, (double) v);
+      hi = std::max(hi, (double) v);
+    }
+    printf("WeightMap: comp %d  %dx%d  min %.4f  max %.4f  mean %.4f\n", c, m_planes[c].width, m_planes[c].height, lo,
+           hi, mean);
+  }
+
+  return true;
+}
+
+bool WeightMap::loadFromFile(const std::string &fileName, int frameIndex)
+{
+  std::ifstream f(fileName, std::ios::binary);
+  if (!f)
+  {
+    printf("WeightMap: cannot open weights file '%s'\n", fileName.c_str());
+    return false;
+  }
+
+  uint32_t numFrames = 0;
+  if (!f.read(reinterpret_cast<char *>(&numFrames), sizeof(uint32_t)))
+  {
+    printf("WeightMap: cannot read the frame count from '%s'\n", fileName.c_str());
+    return false;
+  }
+  if (frameIndex < 0 || (uint32_t) frameIndex >= numFrames)
+  {
+    printf("WeightMap: frame %d requested, file '%s' holds %u frames\n", frameIndex, fileName.c_str(), numFrames);
+    return false;
+  }
+
+  size_t frameSize = 0;
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    frameSize += (size_t) m_planes[c].width * (size_t) m_planes[c].height * sizeof(float);
+  }
+
+  f.seekg((std::streamoff) sizeof(uint32_t) + (std::streamoff) frameIndex * (std::streamoff) frameSize, std::ios::beg);
+  if (!f)
+  {
+    printf("WeightMap: cannot seek to frame %d in '%s'\n", frameIndex, fileName.c_str());
+    return false;
+  }
+
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_planes[c].w.empty())
+    {
+      continue;
+    }
+    if (!f.read(reinterpret_cast<char *>(m_planes[c].w.data()), (std::streamsize) (m_planes[c].w.size() * sizeof(float))))
+    {
+      printf("WeightMap: truncated weights for component %d in '%s'\n", c, fileName.c_str());
+      return false;
+    }
+    for (float &v: m_planes[c].w)
+    {
+      if (!std::isfinite(v) || v < 0.0f)
+      {
+        printf("WeightMap: component %d holds a negative or non-finite weight (%f)\n", c, v);
+        return false;
+      }
+    }
+  }
+
+  return true;
+}
+
+void WeightMap::applyTau()
+{
+  // w <- (w + tau * refMean) / ((1 + tau) * refMean).  tau = 0 keeps the raw importance map,
+  // tau -> inf falls back to plain SSE, and the result has mean one so lambda keeps its usual
+  // calibration.
+  //
+  // refMean is per plane by default, which normalises every plane to mean one and therefore
+  // leaves VTM's tuned luma/chroma lambda balance untouched -- but it also throws away whatever
+  // cross-plane balance the metric's Hessian carried.  With globalNorm one common mean is used
+  // instead, so the ratios between planes survive.
+  double gmean = 1.0;
+  if (m_globalNorm)
+  {
+    double sum = 0.0;
+    size_t cnt = 0;
+    for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+    {
+      sum += std::accumulate(m_planes[c].w.begin(), m_planes[c].w.end(), 0.0);
+      cnt += m_planes[c].w.size();
+    }
+    gmean = cnt ? sum / (double) cnt : 1.0;
+    if (!(gmean > 0.0))
+    {
+      gmean = 1.0;
+    }
+  }
+
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_planes[c].w.empty())
+    {
+      continue;
+    }
+
+    double mean = gmean;
+    if (!m_globalNorm)
+    {
+      mean = std::accumulate(m_planes[c].w.begin(), m_planes[c].w.end(), 0.0) / (double) m_planes[c].w.size();
+      if (!(mean > 0.0))
+      {
+        mean = 1.0;
+      }
+    }
+
+    const double scale = 1.0 / (mean * (1.0 + m_tau));
+    for (float &v: m_planes[c].w)
+    {
+      v = (float) (((double) v + m_tau * mean) * scale);
+    }
+  }
+}
+
+bool WeightMap::loadBlockFile(const std::string &fileName)
+{
+  std::ifstream f(fileName, std::ios::binary);
+  if (!f)
+  {
+    printf("WeightMap: cannot open block-Hessian file '%s'\n", fileName.c_str());
+    return false;
+  }
+  uint32_t magic = 0, blk = 0;
+  f.read(reinterpret_cast<char *>(&magic), 4);
+  f.read(reinterpret_cast<char *>(&blk), 4);
+  if (magic == 0x4B484232u || magic == 0x4B484233u)
+  {
+    return loadFactorFile(f, blk, magic == 0x4B484233u);
+  }
+  if (magic != 0x31484257u || blk == 0 || blk > 32)
+  {
+    printf("WeightMap: '%s' is not a block-Hessian file (magic %08x blk %u)\n", fileName.c_str(), magic, blk);
+    return false;
+  }
+  m_blkSize = (int) blk;
+  const size_t n = (size_t) blk * blk;
+
+  double sumDiag[MAX_NUM_COMPONENT] = { 0.0, 0.0, 0.0 };
+  size_t cntDiag[MAX_NUM_COMPONENT]  = { 0, 0, 0 };
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    uint32_t nby = 0, nbx = 0;
+    f.read(reinterpret_cast<char *>(&nby), 4);
+    f.read(reinterpret_cast<char *>(&nbx), 4);
+    m_nby[c] = (int) nby;
+    m_nbx[c] = (int) nbx;
+    const size_t cnt = (size_t) nby * nbx * n * n;
+    m_blk[c].resize(cnt);
+    if (cnt && !f.read(reinterpret_cast<char *>(m_blk[c].data()), (std::streamsize) (cnt * sizeof(float))))
+    {
+      printf("WeightMap: truncated block data for component %d\n", c);
+      return false;
+    }
+    for (size_t b = 0; b < (size_t) nby * nbx; b++)
+    {
+      const float *M = &m_blk[c][b * n * n];
+      for (size_t i = 0; i < n; i++)
+      {
+        sumDiag[c] += M[i * n + i];
+        cntDiag[c]++;
+      }
+    }
+  }
+  double gsum = 0.0;
+  size_t gcnt = 0;
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    gsum += sumDiag[c];
+    gcnt += cntDiag[c];
+  }
+  if (!gcnt || !(gsum > 0.0))
+  {
+    printf("WeightMap: degenerate block-Hessian file\n");
+    return false;
+  }
+
+  // Same convention as the diagonal path: mean of diag(H) is one, then shrink towards the
+  // identity by tau so lambda keeps its calibration and the form stays PSD.
+  //
+  // Per plane by default.  Normalising all planes against one global mean is wrong whenever a
+  // plane is inactive: a luma-only metric ships identity blocks for chroma, whose diagonal of 1
+  // then dwarfs a luma Hessian of order 1e-9, the global mean collapses to the chroma value and
+  // luma distortion is scaled to nothing.
+  const double gmean = gsum / (double) gcnt;
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_blk[c].empty() || cntDiag[c] == 0)
+    {
+      continue;
+    }
+    const double mean  = m_globalNorm ? gmean : (sumDiag[c] / (double) cntDiag[c]);
+    if (!(mean > 0.0))
+    {
+      continue;
+    }
+    const double scale = 1.0 / (mean * (1.0 + m_tau));
+    const double add   = m_tau * mean;
+    bool         diagOnly = true;   // every tile of this plane has all off-diagonals exactly zero
+    for (size_t b = 0; b * n * n < m_blk[c].size(); b++)
+    {
+      float *M = &m_blk[c][b * n * n];
+      for (size_t i = 0; i < n * n; i++)
+      {
+        M[i] = (float) (M[i] * scale);
+      }
+      for (size_t i = 0; i < n; i++)
+      {
+        M[i * n + i] += (float) (add * scale);
+      }
+      // symmetrise once, so the kernel can use the upper triangle exactly
+      for (size_t i = 0; i < n; i++)
+      {
+        for (size_t j = i + 1; j < n; j++)
+        {
+          const float v = 0.5f * (M[i * n + j] + M[j * n + i]);
+          M[i * n + j] = v;
+          M[j * n + i] = v;
+          if (v != 0.f)
+          {
+            diagOnly = false;
+          }
+        }
+      }
+    }
+    // identity / diagonal planes (chroma of a luma-only metric) take the O(n) path in the
+    // kernel; with zero off-diagonals it evaluates to the same double as the dense kernel
+    m_blkDiagOnly[c] = diagOnly;
+    if (diagOnly)
+    {
+      printf("WeightMap: comp %d block tiles are diagonal -> O(n) kernel path\n", c);
+    }
+  }
+
+  // keep the per-sample diagonal consistent with the block form: everything else that reads
+  // the map (the RDOQ lambda scaling via getMeanWeight, the reporting) then agrees with the
+  // distortion actually being minimised, and no separate .dat is needed.
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_planes[c].w.empty() || m_nbx[c] == 0)
+    {
+      continue;
+    }
+    for (int by = 0; by < m_nby[c]; by++)
+    {
+      for (int bx = 0; bx < m_nbx[c]; bx++)
+      {
+        const float *M = &m_blk[c][((size_t) by * m_nbx[c] + bx) * n * n];
+        for (int r = 0; r < m_blkSize; r++)
+        {
+          const int y = by * m_blkSize + r;
+          if (y >= m_planes[c].height)
+          {
+            continue;
+          }
+          for (int col = 0; col < m_blkSize; col++)
+          {
+            const int x = bx * m_blkSize + col;
+            if (x >= m_planes[c].width)
+            {
+              continue;
+            }
+            const size_t i = (size_t) r * m_blkSize + col;
+            m_planes[c].w[(size_t) y * m_planes[c].stride + x] = M[i * n + i];
+          }
+        }
+      }
+    }
+  }
+
+  m_hasBlocks = true;
+  printf("WeightMap: block Hessians %dx%d, per-plane mean diag %.3e / %.3e / %.3e -> normalised, tau %.3f\n",
+         m_blkSize, m_blkSize,
+         cntDiag[0] ? sumDiag[0] / (double) cntDiag[0] : 0.0,
+         cntDiag[1] ? sumDiag[1] / (double) cntDiag[1] : 0.0,
+         cntDiag[2] ? sumDiag[2] / (double) cntDiag[2] : 0.0, m_tau);
+  return true;
+}
+
+double WeightMap::getMeanWeight(const ComponentID compId, const int x, const int y, const int width,
+                                const int height) const
+{
+  const Plane &p = m_planes[compId];
+  if (!m_enabled || p.w.empty())
+  {
+    return 1.0;
+  }
+
+  const int x0 = std::max(0, x);
+  const int y0 = std::max(0, y);
+  const int x1 = std::min(p.width, x + width);
+  const int y1 = std::min(p.height, y + height);
+  if (x1 <= x0 || y1 <= y0)
+  {
+    return 1.0;
+  }
+
+  double sum = 0.0;
+  for (int j = y0; j < y1; j++)
+  {
+    const float *row = &p.w[(size_t) j * (size_t) p.stride];
+    for (int i = x0; i < x1; i++)
+    {
+      sum += row[i];
+    }
+  }
+  return sum / (double) ((x1 - x0) * (y1 - y0));
+}
+
+bool WeightMap::loadFactorFile(std::ifstream &f, uint32_t blk, bool withDiag)
+{
+  m_hasFacDiag = withDiag;
+  uint32_t K = 0;
+  f.read(reinterpret_cast<char *>(&K), 4);
+  if (blk == 0 || blk > 32 || K == 0 || K > blk * blk)
+  {
+    printf("WeightMap: bad factored tile header (blk %u K %u)\n", blk, K);
+    return false;
+  }
+  m_blkSize = (int) blk;
+  m_K       = (int) K;
+  const size_t n = (size_t) blk * blk;
+  double sumDiag[MAX_NUM_COMPONENT] = { 0.0, 0.0, 0.0 };
+  size_t cntDiag[MAX_NUM_COMPONENT] = { 0, 0, 0 };
+  std::vector<float> tmp;
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    uint32_t nby = 0, nbx = 0;
+    f.read(reinterpret_cast<char *>(&nby), 4);
+    f.read(reinterpret_cast<char *>(&nbx), 4);
+    m_nby[c] = (int) nby;
+    m_nbx[c] = (int) nbx;
+    const size_t cnt = (size_t) nby * nbx * n * K;
+    tmp.resize(cnt);
+    if (cnt && !f.read(reinterpret_cast<char *>(tmp.data()), (std::streamsize) (cnt * sizeof(float))))
+    {
+      printf("WeightMap: truncated factor data for component %d\n", c);
+      return false;
+    }
+    // file is tile-major, [n][K]; store [K][n] per tile for contiguous dot products
+    m_fac[c].resize(cnt);
+    for (size_t b = 0; b < (size_t) nby * nbx; b++)
+    {
+      const float *src = &tmp[b * n * K];
+      float       *dst = &m_fac[c][b * n * K];
+      for (size_t i = 0; i < n; i++)
+      {
+        double d = 0.0;
+        for (size_t k = 0; k < K; k++)
+        {
+          const float v = src[i * K + k];
+          dst[k * n + i] = v;
+          d += (double) v * v;
+        }
+        sumDiag[c] += d;
+        cntDiag[c]++;
+      }
+    }
+    if (withDiag)
+    {
+      const size_t cd = (size_t) nby * nbx * n;
+      m_facDiag[c].resize(cd);
+      if (cd && !f.read(reinterpret_cast<char *>(m_facDiag[c].data()), (std::streamsize) (cd * sizeof(float))))
+      {
+        printf("WeightMap: truncated residual-diagonal data for component %d\n", c);
+        return false;
+      }
+      for (size_t i = 0; i < cd; i++)
+      {
+        sumDiag[c] += m_facDiag[c][i];
+      }
+    }
+  }
+  double gsum = 0.0;
+  size_t gcnt = 0;
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    gsum += sumDiag[c];
+    gcnt += cntDiag[c];
+  }
+  if (!gcnt || !(gsum > 0.0))
+  {
+    printf("WeightMap: degenerate factored tile file\n");
+    return false;
+  }
+  // Same convention as the dense path: mean of diag(H) is one per plane, then shrink to the
+  // identity by tau.  The tau term is not low rank, so it is carried as facAdd * ||e||^2.
+  const double gmean = gsum / (double) gcnt;
+  m_facAdd = (float) (m_tau / (1.0 + m_tau));
+  double meanUsed[MAX_NUM_COMPONENT] = { 0.0, 0.0, 0.0 };
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_fac[c].empty() || cntDiag[c] == 0)
+    {
+      continue;
+    }
+    const double mean = m_globalNorm ? gmean : (sumDiag[c] / (double) cntDiag[c]);
+    meanUsed[c] = mean;
+    if (!(mean > 0.0))
+    {
+      continue;
+    }
+    const float s = (float) std::sqrt(1.0 / (mean * (1.0 + m_tau)));
+    for (size_t i = 0; i < m_fac[c].size(); i++)
+    {
+      m_fac[c][i] *= s;
+    }
+    for (size_t i = 0; i < m_facDiag[c].size(); i++)
+    {
+      m_facDiag[c][i] *= s * s;
+    }
+  }
+  // per-sample diagonal, so getMeanWeight / weighted RDOQ see the same map
+  for (int c = 0; c < MAX_NUM_COMPONENT; c++)
+  {
+    if (m_planes[c].w.empty() || m_nbx[c] == 0)
+    {
+      continue;
+    }
+    for (int by = 0; by < m_nby[c]; by++)
+    {
+      for (int bx = 0; bx < m_nbx[c]; bx++)
+      {
+        const float *F = &m_fac[c][((size_t) by * m_nbx[c] + bx) * n * K];
+        for (int r = 0; r < m_blkSize; r++)
+        {
+          const int y = by * m_blkSize + r;
+          if (y >= m_planes[c].height)
+          {
+            continue;
+          }
+          for (int col = 0; col < m_blkSize; col++)
+          {
+            const int x = bx * m_blkSize + col;
+            if (x >= m_planes[c].width)
+            {
+              continue;
+            }
+            const size_t i = (size_t) r * m_blkSize + col;
+            double d = m_facAdd;
+            for (size_t k = 0; k < K; k++)
+            {
+              d += (double) F[k * n + i] * F[k * n + i];
+            }
+            if (withDiag)
+            {
+              d += m_facDiag[c][((size_t) by * m_nbx[c] + bx) * n + i];
+            }
+            m_planes[c].w[(size_t) y * m_planes[c].stride + x] = (float) d;
+          }
+        }
+      }
+    }
+  }
+  m_hasBlocks  = true;
+  m_hasFactors = true;
+  printf("WeightMap: rank-%u factored tiles%s %dx%d, per-plane mean diag %.3e / %.3e / %.3e -> normalised, tau %.3f\n",
+         K, withDiag ? " + residual diagonal" : "", m_blkSize, m_blkSize, meanUsed[0], meanUsed[1], meanUsed[2], m_tau);
+  return true;
+}
diff -urN '--exclude=build' '--exclude=bin' '--exclude=*.orig' '--exclude=.git' VTM_stock/source/Lib/CommonLib/WeightMap.h VTM_WMSE/source/Lib/CommonLib/WeightMap.h
--- VTM_stock/source/Lib/CommonLib/WeightMap.h	1969-12-31 16:00:00.000000000 -0800
+++ VTM_WMSE/source/Lib/CommonLib/WeightMap.h	2026-09-03 13:12:50.727446493 -0700
@@ -0,0 +1,149 @@
+/** \file     WeightMap.h
+    \brief    per-pixel importance weights for weighted-MSE RDO (header)
+
+    The weights are the diagonal of the Hessian of a perceptual metric, evaluated
+    at the source picture.  Feeding them to the encoder turns the RD objective
+    J = SSE + lambda * R into J = sum_i w_i (x_i - xhat_i)^2 + lambda * R, which is
+    a second-order approximation of  metric(x, xhat) + lambda * R.
+
+    File format (little endian, matches the .dat produced by the python side):
+      uint32                          numFrames
+      repeated numFrames times:
+        float32 [ lumaW * lumaH ]     Y plane, raster scan
+        float32 [ chromaW * chromaH ] Cb plane, raster scan
+        float32 [ chromaW * chromaH ] Cr plane, raster scan
+*/
+
+#ifndef __WEIGHTMAP__
+#define __WEIGHTMAP__
+
+#include "CommonDef.h"
+#include "ChromaFormat.h"
+
+#include <string>
+#include <vector>
+#include <fstream>
+
+//! \ingroup CommonLib
+//! \{
+
+class WeightMap
+{
+private:
+  struct Plane
+  {
+    std::vector<float> w;
+    int                width  = 0;
+    int                height = 0;
+    ptrdiff_t          stride = 0;
+  };
+
+  Plane m_planes[MAX_NUM_COMPONENT];
+
+  bool   m_enabled = false;
+  double m_tau        = 0.0;   // shrink-to-uniform regularisation: w <- (w + tau) / (1 + tau)
+  bool   m_globalNorm = false; // normalise all planes together instead of one mean per plane
+
+  // optional non-diagonal form: one blk x blk Hessian per blk x blk tile, row-major inside a
+  // tile.  H = 2 J^T J for LPIPS, so these come from the same probes as the diagonal.
+  bool               m_hasBlocks = false;
+  int                m_blkSize   = 0;
+  std::vector<float> m_blk[MAX_NUM_COMPONENT];
+  int                m_nbx[MAX_NUM_COMPONENT] = { 0, 0, 0 };
+  int                m_nby[MAX_NUM_COMPONENT] = { 0, 0, 0 };
+  // set at load when every tile of the plane has all off-diagonals exactly zero (identity
+  // chroma of a luma-only metric): the kernel then takes an O(n) path, bit-identical
+  bool               m_blkDiagOnly[MAX_NUM_COMPONENT] = { false, false, false };
+  // Rank-K factored tiles: H_t = F_t F_t^T + facAdd * I after the tau shrink, F_t stored
+  // k-major (K rows of n) so the kernel does K contiguous dot products instead of an n x n
+  // matvec.  Storage n*K per tile instead of n*n.
+  bool               m_hasFactors = false;
+  int                m_K          = 0;
+  float              m_facAdd     = 0.0f;
+  std::vector<float> m_fac[MAX_NUM_COMPONENT];
+  bool               m_hasFacDiag = false;      // v3: residual diagonal alongside the factors
+  std::vector<float> m_facDiag[MAX_NUM_COMPONENT];
+  int    m_frame   = -1;
+
+public:
+  WeightMap()  = default;
+  ~WeightMap() = default;
+
+  //! allocate the planes (all weights = 1.0) and, if fileName is not empty, load them
+  bool init(int lumaWidth, int lumaHeight, ChromaFormat chromaFormat, const std::string &fileName, int frameIndex,
+            double tau, bool globalNorm = false);
+
+  void clear();
+
+  bool isEnabled() const { return m_enabled; }
+
+  int       getWidth (const ComponentID compId) const { return m_planes[compId].width;  }
+  int       getHeight(const ComponentID compId) const { return m_planes[compId].height; }
+  ptrdiff_t getStride(const ComponentID compId) const { return m_planes[compId].stride; }
+
+  //! pointer to the weight of sample (x, y) of component compId, or nullptr if out of range
+  const float *getPtr(const ComponentID compId, const int x, const int y) const
+  {
+    const Plane &p = m_planes[compId];
+    if (!m_enabled || p.w.empty() || x < 0 || y < 0 || x >= p.width || y >= p.height)
+    {
+      return nullptr;
+    }
+    return &p.w[(size_t) y * (size_t) p.stride + (size_t) x];
+  }
+
+  //! mean weight of a rectangle, used to scale the RDOQ / transform-domain lambda
+  double getMeanWeight(const ComponentID compId, const int x, const int y, const int width, const int height) const;
+
+  double getTau() const { return m_tau; }
+
+  bool hasBlocks()   const { return m_hasBlocks; }
+  int  getBlkSize()  const { return m_blkSize; }
+  int  getNumBlkX(const ComponentID c) const { return m_nbx[c]; }
+  int  getNumBlkY(const ComponentID c) const { return m_nby[c]; }
+  bool blockPlaneIsDiagonal(const ComponentID c) const { return m_hasBlocks && m_blkDiagOnly[c]; }
+
+  //! the blk*blk x blk*blk Hessian of the tile containing sample (x, y), or nullptr
+  const float *getBlockMatrix(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasBlocks || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_blk[compId][((size_t) by * m_nbx[compId] + bx) * n * n];
+  }
+
+  bool loadBlockFile(const std::string &fileName);
+  bool loadFactorFile(std::ifstream &f, uint32_t blk, bool withDiag);
+  bool hasFacDiag() const { return m_hasFacDiag; }
+  const float *getBlockFacDiag(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasFacDiag || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_facDiag[compId][((size_t) by * m_nbx[compId] + bx) * n];
+  }
+  bool  hasFactors() const { return m_hasFactors; }
+  int   getK()       const { return m_K; }
+  float getFacAdd()  const { return m_facAdd; }
+  const float *getBlockFactor(const ComponentID compId, const int bx, const int by) const
+  {
+    if (!m_hasFactors || bx < 0 || by < 0 || bx >= m_nbx[compId] || by >= m_nby[compId])
+    {
+      return nullptr;
+    }
+    const size_t n = (size_t) m_blkSize * m_blkSize;
+    return &m_fac[compId][((size_t) by * m_nbx[compId] + bx) * n * (size_t) m_K];
+  }
+
+private:
+  bool loadFromFile(const std::string &fileName, int frameIndex);
+  void applyTau();
+};
+
+//! \}
+
+#endif   // __WEIGHTMAP__

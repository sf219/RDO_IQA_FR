 // ====================================================================================================================
+// Weighted-MSE RDO
+// ====================================================================================================================
+
+bool RdCost::resolveOrgPos(const ComponentID compID, const Pel *p, ptrdiff_t stride, int &x, int &y) const
+{
+  for (int slot = 0; slot < 2; slot++)
+  {
+    const Pel *origin = m_orgOrigin[slot][compID];
+    if (origin == nullptr || stride != m_orgOriginStride[slot][compID])
+    {
+      continue;
+    }
+
+    const ptrdiff_t off = p - origin;
+    if (off < 0 || off >= m_orgOriginStride[slot][compID] * (ptrdiff_t) m_orgOriginHeight[slot][compID])
+    {
+      continue;
+    }
+
+    const int xx = (int) (off % m_orgOriginStride[slot][compID]);
+    const int yy = (int) (off / m_orgOriginStride[slot][compID]);
+    if (xx >= m_orgOriginWidth[slot][compID])
+    {
+      continue;
+    }
+
+    x = xx;
+    y = yy;
+    return true;
+  }
+  return false;
+}
+
+//! attach the importance weights of the block that "org" points at; returns false when the block
+//! could not be located in the source picture (residual-domain distortions, temporary buffers, ...)
+bool RdCost::attachWeights(DistParam &dp, const CPelBuf &org, const ComponentID compID) const
+{
+  dp.weights      = nullptr;
+  dp.weightStride = 0;
+
+  if (m_weightMap == nullptr || !m_weightMap->isEnabled())
+  {
+    return false;
+  }
+
+  int x = 0;
+  int y = 0;
+  if (!resolveOrgPos(compID, org.buf, org.stride, x, y))
+  {
+    m_unweightedCalls++;
+    return false;
+  }
+
+  if (x + (int) org.width > m_weightMap->getWidth(compID) || y + (int) org.height > m_weightMap->getHeight(compID))
+  {
+    m_unweightedCalls++;
+    return false;
+  }
+
+  const float *w = m_weightMap->getPtr(compID, x, y);
+  if (w == nullptr)
+  {
+    m_unweightedCalls++;
+    return false;
+  }
+
+  dp.weights      = w;
+  dp.weightStride = m_weightMap->getStride(compID);
+  dp.blkX         = x;
+  dp.blkY         = y;
+  m_weightedCalls++;
+  return true;
+}
+
+Distortion RdCost::xGetSSEWeighted(const DistParam &rcDtParam)
+{
+  const Pel   *piOrg     = rcDtParam.org.buf;
+  const Pel   *piCur     = rcDtParam.cur.buf;
+  const float *piWeight  = rcDtParam.weights;
+  const ptrdiff_t strideOrg = rcDtParam.org.stride;
+  const ptrdiff_t strideCur = rcDtParam.cur.stride;
+  const ptrdiff_t strideWgt = rcDtParam.weightStride;
+  const int    cols      = rcDtParam.org.width;
+  int          rows      = rcDtParam.org.height;
+
+  const uint32_t shift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth) << 1;
+
+  double sum = 0.0;
+  for (; rows != 0; rows--)
+  {
+    for (int n = 0; n < cols; n++)
+    {
+      const int64_t diff = piOrg[n] - piCur[n];
+      sum += (double) (diff * diff) * (double) piWeight[n];
+    }
+    piOrg += strideOrg;
+    piCur += strideCur;
+    piWeight += strideWgt;
+  }
+
+  return (Distortion) (sum / (double) (1 << shift));
+}
+
+//! sum over the blk x blk tiles the block overlaps of  e^T H_t e,  with e zero outside the
+//! block, which handles partial tiles and sub-tile transform units without special cases.
+Distortion RdCost::xGetSSEBlockHessian(const DistParam &rcDtParam) const
+{
+  const Pel      *piOrg = rcDtParam.org.buf;
+  const Pel      *piCur = rcDtParam.cur.buf;
+  const ptrdiff_t so    = rcDtParam.org.stride;
+  const ptrdiff_t sc    = rcDtParam.cur.stride;
+  const int       cols  = rcDtParam.org.width;
+  const int       rows  = rcDtParam.org.height;
+  const ComponentID compID = rcDtParam.compID;
+
+  const int   blk = m_weightMap->getBlkSize();
+  const int   n   = blk * blk;
+  const int   x0  = rcDtParam.blkX;
+  const int   y0  = rcDtParam.blkY;
+
+  static thread_local std::vector<double> e;
+  e.resize(n);
+
+  const uint32_t shift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth) << 1;
+  double sum = 0.0;
+
+  const int tx0 = x0 / blk, tx1 = (x0 + cols - 1) / blk;
+  const int ty0 = y0 / blk, ty1 = (y0 + rows - 1) / blk;
+
+  for (int ty = ty0; ty <= ty1; ty++)
+  {
+    for (int tx = tx0; tx <= tx1; tx++)
+    {
+      const bool   useFac = m_weightMap->hasFactors();
+      const float *F      = useFac ? m_weightMap->getBlockFactor(compID, tx, ty) : nullptr;
+      const float *M      = useFac ? nullptr : m_weightMap->getBlockMatrix(compID, tx, ty);
+      if ((useFac && F == nullptr) || (!useFac && M == nullptr))
+      {
+        continue;
+      }
+      std::fill(e.begin(), e.end(), 0.0);
+      bool any = false;
+      for (int r = 0; r < blk; r++)
+      {
+        const int gy = ty * blk + r;             // absolute row
+        const int ly = gy - y0;                  // row inside the coded block
+        if (ly < 0 || ly >= rows)
+        {
+          continue;
+        }
+        for (int c = 0; c < blk; c++)
+        {
+          const int gx = tx * blk + c;
+          const int lx = gx - x0;
+          if (lx < 0 || lx >= cols)
+          {
+            continue;
+          }
+          e[r * blk + c] = (double) (piOrg[ly * so + lx] - piCur[ly * sc + lx]);
+          any = true;
+        }
+      }
+      if (!any)
+      {
+        continue;
+      }
+      if (!useFac && m_weightMap->blockPlaneIsDiagonal(compID))
+      {
+        // all off-diagonals of this plane's tiles are exactly zero: the dense kernel below
+        // would evaluate e_i (M_ii e_i + 2*0) per row, so this is the same double, in O(n)
+        double q = 0.0;
+        for (int i = 0; i < n; i++)
+        {
+          const float ei = (float) e[i];
+          if (ei == 0.f)
+          {
+            continue;
+          }
+          q += (double) ei * ((double) M[(size_t) i * n + i] * ei + 0.0);
+        }
+        sum += q;
+        continue;
+      }
+      if (useFac)
+      {
+        // e^T (F F^T + add I) e = sum_k (F_k . e)^2 + add * ||e||^2,  K*n MACs instead of n*n
+        const int    K   = m_weightMap->getK();
+        const double add = m_weightMap->getFacAdd();
+        float ef[1024];
+        double ee = 0.0;
+        for (int i = 0; i < n; i++)
+        {
+          ef[i] = (float) e[i];
+          ee += e[i] * e[i];
+        }
+        double q = 0.0;
+        for (int k = 0; k < K; k++)
+        {
+          const float *Fk = F + (size_t) k * n;
+          float a0 = 0.f, a1 = 0.f, a2 = 0.f, a3 = 0.f;
+          int i = 0;
+          for (; i + 3 < n; i += 4)
+          {
+            a0 += Fk[i] * ef[i];
+            a1 += Fk[i + 1] * ef[i + 1];
+            a2 += Fk[i + 2] * ef[i + 2];
+            a3 += Fk[i + 3] * ef[i + 3];
+          }
+          for (; i < n; i++)
+          {
+            a0 += Fk[i] * ef[i];
+          }
+          const double acc = (double) ((a0 + a1) + (a2 + a3));
+          q += acc * acc;
+        }
+        if (m_weightMap->hasFacDiag())
+        {
+          const float *Dr = m_weightMap->getBlockFacDiag(compID, tx, ty);
+          double dq = 0.0;
+          for (int i = 0; i < n; i++)
+          {
+            dq += (double) Dr[i] * ef[i] * ef[i];
+          }
+          q += dq;
+        }
+        sum += q + add * ee;
+        continue;
+      }
+      // Exact tile form, exploiting symmetry (tiles are symmetrised at load):
+      //   e^T M e = sum_i e_i ( M_ii e_i + 2 sum_{j>i} M_ij e_j )
+      // Half the memory traffic of the full matvec, float with independent accumulators so
+      // the contiguous inner loop vectorises; the per-tile total is accumulated in double.
+      {
+        float ef[1024];
+        for (int i = 0; i < n; i++)
+        {
+          ef[i] = (float) e[i];
+        }
+        double q = 0.0;
+        for (int i = 0; i < n; i++)
+        {
+          const float ei = ef[i];
+          if (ei == 0.f)
+          {
+            continue;
+          }
+          const float *Mi = M + (size_t) i * n;
+          float s0 = 0.f, s1 = 0.f, s2 = 0.f, s3 = 0.f;
+          int j = i + 1;
+          for (; j + 3 < n; j += 4)
+          {
+            s0 += Mi[j] * ef[j];
+            s1 += Mi[j + 1] * ef[j + 1];
+            s2 += Mi[j + 2] * ef[j + 2];
+            s3 += Mi[j + 3] * ef[j + 3];
+          }
+          for (; j < n; j++)
+          {
+            s0 += Mi[j] * ef[j];
+          }
+          const float off = (s0 + s1) + (s2 + s3);
+          q += (double) ei * ((double) Mi[i] * ei + 2.0 * (double) off);
+        }
+        sum += q;
+      }
+    }
+  }
+  return (Distortion) std::max(0.0, sum / (double) (1 << shift));
+}
+
+Distortion RdCost::xGetSSEWeighted_WTD(const DistParam &rcDtParam) const
+{
+  const Pel   *piOrg      = rcDtParam.org.buf;
+  const Pel   *piCur      = rcDtParam.cur.buf;
+  const Pel   *piOrgLuma  = rcDtParam.orgLuma.buf;
+  const float *piWeight   = rcDtParam.weights;
+  const ptrdiff_t strideOrg     = rcDtParam.org.stride;
+  const ptrdiff_t strideCur     = rcDtParam.cur.stride;
+  const ptrdiff_t strideOrgLuma = rcDtParam.orgLuma.stride;
+  const ptrdiff_t strideWgt     = rcDtParam.weightStride;
+  const size_t cShift  = rcDtParam.cShiftX;
+  const size_t cShiftY = rcDtParam.cShiftY;
+  const int    cols    = rcDtParam.org.width;
+  int          rows    = rcDtParam.org.height;
+
+  const uint32_t shift = DISTORTION_PRECISION_ADJUSTMENT(rcDtParam.bitDepth) << 1;
+
+  double sum = 0.0;
+  for (; rows != 0; rows--)
+  {
+    for (int n = 0; n < cols; n++)
+    {
+      const int64_t diff   = piOrg[n] - piCur[n];
+      const int64_t lumaWt = m_reshapeLumaLevelToWeightPLUT[piOrgLuma[n << cShift]];
+      sum += (double) (lumaWt * diff * diff) * (double) piWeight[n];
+    }
+    piOrg += strideOrg;
+    piCur += strideCur;
+    piWeight += strideWgt;
+    piOrgLuma += strideOrgLuma << cShiftY;
+  }
+
+  return (Distortion) (sum / (double) (((int64_t) 1) << (MSE_WEIGHT_FRAC_BITS + shift)));
+}
+

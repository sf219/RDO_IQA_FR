+  bool       ctxWeighted(int ctx) const                    { return ((m_decisionMask >> ctx) & 1) != 0; }
+  Distortion pick(int ctx, Distortion w, Distortion p) const { return ctxWeighted(ctx) ? w : p; }
+  void       getLastDistPair(Distortion &w, Distortion &p) const { w = m_lastDistW; p = m_lastDistP; }
+  double     distToCost(Distortion d) const
+  {
+#if WCG_EXT
+    return m_distScaleUnadjusted * double(d);
+#else
+    return m_distScale * double(d);
+#endif
+  }
+  //! RD cost of a candidate whose cost was computed from `dist`, re-expressed with distortion `pickd`
+  double     adjCost(double cost, Distortion dist, Distortion pickd) const
+  {
+    if (pickd == dist || cost >= MAX_DOUBLE / 2)
+    {
+      return cost;   // exact: no floating-point round trip when nothing changes
+    }
+    return cost - distToCost(dist) + distToCost(pickd);
+  }
